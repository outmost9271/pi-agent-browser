+fn validate_required_sandbox(args: &[String], required: bool) -> Result<(), String> {
+    if required {
+        for arg in args {
+            let name = arg.split('=').next().unwrap_or(arg);
+            if matches!(name,
+                "--no-sandbox" | "--disable-setuid-sandbox" |
+                "--disable-namespace-sandbox" | "--disable-seccomp-filter-sandbox" |
+                "--disable-gpu-sandbox" | "--single-process" | "--no-zygote") {
+                return Err(format!("PIAB_REQUIRE_SANDBOX conflicts with {name}"));
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod required_sandbox_tests {
+    use super::validate_required_sandbox;
+
+    #[test]
+    fn rejects_sandbox_bypass_flags_including_equals_form() {
+        for flag in ["--no-sandbox", "--disable-setuid-sandbox",
+            "--disable-namespace-sandbox", "--disable-seccomp-filter-sandbox",
+            "--disable-gpu-sandbox", "--single-process", "--no-zygote"] {
+            for argument in [flag.to_string(), format!("{flag}=true")] {
+                assert!(validate_required_sandbox(&[argument.clone()], true).is_err());
+                assert!(validate_required_sandbox(&[argument], false).is_ok());
+            }
+        }
+    }
+
+    #[test]
+    fn preserves_regular_browser_arguments() {
+        assert!(validate_required_sandbox(&[
+            "--headless=new".to_string(), "--window-size=1280,720".to_string()
+        ], true).is_ok());
+    }
+}
